FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    sphereToCell
    {
        centre (0 0 0.02);  // 球心坐标
        radius 0.00215;        // 半径（单位：米）
        fieldValues
        (
            volScalarFieldValue alpha.water 1  // 球内设为水
            volVectorFieldValue U (0 0 0)
        );
    }
);


