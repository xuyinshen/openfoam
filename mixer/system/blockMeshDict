FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Background mesh for the snappy sliding-mesh mixer.
// A single coarse hex fills the square vessel; snappyHexMesh refines it around
// the impeller and cuts the rotating cellZone + sliding interface.
// Vessel: x,y in [-0.25, 0.25] (0.5 m square), z in [0, 0.5].
// Rotation axis: z through (0,0).

convertToMeters 1;

vertices
(
    (-0.25 -0.25  0)   // 0
    ( 0.25 -0.25  0)   // 1
    ( 0.25  0.25  0)   // 2
    (-0.25  0.25  0)   // 3
    (-0.25 -0.25  0.5) // 4
    ( 0.25 -0.25  0.5) // 5
    ( 0.25  0.25  0.5) // 6
    (-0.25  0.25  0.5) // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (32 32 32) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    tankBottom
    {
        type wall;
        inGroups (wall staticWalls);
        faces
        (
            (0 3 2 1)
        );
    }

    tankTop
    {
        type wall;
        inGroups (wall staticWalls);
        faces
        (
            (4 5 6 7)
        );
    }

    tankWall
    {
        type wall;
        inGroups (wall staticWalls);
        faces
        (
            (1 5 6 2)   // +x
            (2 6 7 3)   // +y
            (3 7 4 0)   // -x
            (0 4 5 1)   // -y
        );
    }
);

