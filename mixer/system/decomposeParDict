FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// MPI decomposition (plane6 format). scotch graph partitioning; keeps the rotor
// cellZone / rotorInterface faceZone / nonConformalCyclic couple across ranks.
// numberOfSubdomains must match the -np used in MakeMesh / SolveRun / Allrun.

numberOfSubdomains 8;

method          scotch;

simpleCoeffs
{
    n               (2 2 2);
    delta           0.001;
}

hierarchicalCoeffs
{
    n               (2 2 2);
    delta           0.001;
    order           xyz;
}

manualCoeffs
{
    dataFile        "";
}

distributed     no;

roots           ( );

